{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "outputDirectory": ".next",
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/alerts/run",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/intelligence/ingest",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/forecasts/generate",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/forecasts/evaluate",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/account/deletion/reconcile",
      "schedule": "30 5 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  }
}
