NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional SaaS billing. Keep unset until Stripe test mode, prices and the signed webhook are configured together.
# Never expose these values through NEXT_PUBLIC_ variables.
STOCKPILOT_APP_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Preis-IDs je Tarif und Abrechnungszeitraum. Monats- und Jahresabo brauchen in
# Stripe je eine eigene Preis-ID; ein Jahrespreis laesst sich nicht aus einem
# Monatspreis ableiten. Fehlt eine ID, ist der jeweilige Zeitraum nicht buchbar
# und erscheint auch nicht als Knopf.
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PREMIUM_YEARLY_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
# Stripe billing configuration. Required only when Stripe is used for subscriptions.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=

# Optional native app remote WebView target. Leave empty to use bundled Capacitor web assets.
# Must be HTTPS; never point production builds at localhost or another project.
CAPACITOR_SERVER_URL=

# Provider selection. Production fails closed when no real provider is configured.
# Mock fixtures are only available in development/tests and never on Vercel Production.
MARKET_DATA_PROVIDER=auto
STOCKPILOT_MARKET_PROVIDER=auto
STOCKPILOT_QUOTE_PROVIDER=auto
STOCKPILOT_CRYPTO_PROVIDER=binance
STOCKPILOT_NEWS_PROVIDER=auto
STOCKPILOT_FUNDAMENTALS_PROVIDER=auto
STOCKPILOT_AI_PROVIDER=evidence
STOCKPILOT_ALLOW_TEST_FIXTURES=false

# Realtime Intelligence. Ingestion is server-only and disabled until the
# required provider, Supabase and secret values are configured.
STOCKPILOT_INTELLIGENCE_PROVIDERS=fmp,sec_edgar
STOCKPILOT_INTELLIGENCE_SYMBOLS=AAPL,MSFT,NVDA
STOCKPILOT_SEC_ENTITIES=AAPL:0000320193,MSFT:0000789019,NVDA:0001045810
STOCKPILOT_INTELLIGENCE_INGEST_SECRET=
SEC_EDGAR_USER_AGENT=StockPilotAI Operations contact@example.com
SEC_MIN_REQUEST_INTERVAL_MS=125
STOCKPILOT_INTELLIGENCE_READ_TIMEOUT_MS=2500
STOCKPILOT_INTELLIGENCE_BATCH_LIMIT=7
FINNHUB_DATA_QUALITY=near_realtime
# Finnhub WebSocket ist ein Trade-Stream (kein Bid/Ask-Quote-Stream).
# Der aktive Tarif erlaubt nur eine Verbindung je Key; deshalb serverseitig zentral betreiben.
FINNHUB_STREAM_ENABLED=false
FINNHUB_STREAM_MAX_SYMBOLS=30
BINANCE_DATA_QUALITY=near_realtime
COINBASE_DATA_QUALITY=near_realtime
TWELVE_DATA_QUALITY=near_realtime
TWELVE_DATA_BATCH_MAX_SYMBOLS=8
# Nur aktivieren, wenn der Twelve-Data-Tarif WebSocket fuer die benoetigten
# Symbole erlaubt. Basic/Grow sind auf Trial-Symbole begrenzt.
TWELVE_DATA_STREAM_ENABLED=false
TWELVE_DATA_STREAM_MAX_SYMBOLS=8
EODHD_DATA_QUALITY=delayed
MASSIVE_DATA_QUALITY=delayed
FMP_DATA_QUALITY=delayed
FMP_ENABLE_ETF_QUOTES=false
ALPHA_VANTAGE_DATA_QUALITY=delayed

# Server-only market/news/fundamental providers. Never prefix these with NEXT_PUBLIC_.
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=
POLYGON_API_KEY=
MASSIVE_API_KEY=
TWELVE_DATA_API_KEY=
TWELVEDATA_API_KEY=
YAHOO_FINANCE_API_KEY=
NEWS_API_KEY=
NEWSAPI_API_KEY=
MARKETAUX_API_KEY=
EODHD_API_KEY=
DATABENTO_API_KEY=

# Refresh/rate-limit tuning.
STOCKPILOT_QUOTE_CACHE_TTL_MS=30000
STOCKPILOT_CRYPTO_QUOTE_CACHE_TTL_MS=3000
STOCKPILOT_STALE_QUOTE_CACHE_TTL_MS=300000
STOCKPILOT_RATE_LIMIT_BACKOFF_MS=60000
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cost controls for API routes and live polling.
STOCKPILOT_QUOTES_TTL_MS=8000
STOCKPILOT_QUOTES_STALE_TTL_MS=90000
STOCKPILOT_STREAM_INTERVAL_MS=15000
STOCKPILOT_STREAM_MIN_INTERVAL_MS=5000
STOCKPILOT_STREAM_MAX_INTERVAL_MS=60000
STOCKPILOT_NEWS_TTL_MS=120000
STOCKPILOT_NEWS_STALE_TTL_MS=900000
STOCKPILOT_FUNDAMENTALS_TTL_MS=3600000
STOCKPILOT_FUNDAMENTALS_STALE_TTL_MS=86400000
STOCKPILOT_AI_TTL_MS=300000
STOCKPILOT_AI_STALE_TTL_MS=1800000
STOCKPILOT_PROFESSIONAL_TTL_MS=120000
STOCKPILOT_PROFESSIONAL_STALE_TTL_MS=600000

# Alert worker safety. Keep false in production until real provider-side alert values are wired.
STOCKPILOT_CRON_SECRET=
CRON_SECRET=
STOCKPILOT_ENABLE_SIMULATED_ALERT_WORKER=false

# Intelligence analysis. "rules" is deterministic and works without a model.
# "openai_compatible" supports OpenAI and later self-hosted vLLM endpoints.
AI_PROVIDER=rules
AI_MAX_OUTPUT_TOKENS=1400
AI_MAX_RESPONSE_BYTES=64000
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=12000
AI_MAX_CONCURRENCY=2
AI_INPUT_COST_PER_MILLION=
AI_OUTPUT_COST_PER_MILLION=

# Enterprise readiness gates. Only set these to true after the external control is genuinely active.
STOCKPILOT_ENTERPRISE_BASELINE_MONITORING_ENABLED=false
STOCKPILOT_ENTERPRISE_PROVIDER_LICENSE_REVIEWED=false
STOCKPILOT_ENTERPRISE_SUPABASE_RLS_VERIFIED=false
STOCKPILOT_ENTERPRISE_SUPABASE_PITR_ENABLED=false
STOCKPILOT_ENTERPRISE_MONITORING_ENABLED=false
STOCKPILOT_ENTERPRISE_SLA_DOCUMENTED=false
STOCKPILOT_ENTERPRISE_INCIDENT_OWNER=
STOCKPILOT_ENTERPRISE_SUPPORT_CONTACT=

# Optional future AI provider.
OPENAI_API_KEY=

# SEC EDGAR verlangt eine Kontaktadresse im User-Agent und sperrt anonyme
# Zugriffe. Kein Schluessel, aber Pflichtangabe.
SEC_CONTACT_EMAIL=
# Zentrales Market-Data-Routing. Preview/Produktion bleiben ohne dokumentierte
# Rechteprüfung fail-closed.
MARKET_DATA_ENV=development
MARKET_DATA_DEFAULT_PROVIDER=auto
MARKET_DATA_ALLOW_EXTERNAL_DISPLAY=false
MARKET_DATA_LICENSE_VERIFIED_PROVIDERS=
MARKET_DATA_EXTERNAL_DISPLAY_PROVIDERS=
MARKET_DATA_LICENSE_VERIFIED_AT=
MARKET_DATA_STALE_AFTER_MS=120000
MARKET_DATA_RETRY_ATTEMPTS=2
# Twelve Basic hat nur Burst 2; mehr als ein Retry wuerde die Fehlerursache
# durch ein lokales Budget-Limit ueberdecken.
MARKET_DATA_RETRY_ATTEMPTS_TWELVE_DATA=1
# Alpaca Basic: IEX-Echtzeitfeed (ein Handelsplatz), 200 REST-Aufrufe/Minute,
# ein WebSocket und maximal 30 abonnierte Symbole. Ausschließlich serverseitig.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex
ALPACA_STREAM_ENABLED=false
ALPACA_STREAM_MAX_SYMBOLS=30
ALPACA_BATCH_MAX_SYMBOLS=30
ALPACA_HISTORY_MAX_PAGES=5
ALPACA_TRADING_ENV=paper
MARKET_DATA_CROSSCHECK_PROVIDER_COUNT=2
MARKET_DATA_ENABLE_FMP=true
MARKET_DATA_ENABLE_TWELVE_DATA=true
MARKET_DATA_ENABLE_ALPACA=false
MARKET_DATA_ENABLE_FINNHUB=true
MARKET_DATA_ENABLE_SEC=true
MARKET_DATA_ENABLE_FRED=false
FRED_API_KEY=
MARKET_DATA_ENABLE_ECB=true
MARKET_DATA_ENABLE_COINGECKO=false
MARKET_DATA_ENABLE_COINBASE=true
MARKET_DATA_ENABLE_BINANCE=true
MARKET_DATA_ENABLE_ALPHA_VANTAGE=true
MARKET_DATA_ENABLE_MASSIVE=true
MARKET_DATA_ENABLE_EODHD=true
MARKET_DATA_ENABLE_DATABENTO=false
MARKET_DATA_ENABLE_MARKETAUX=true
MARKET_DATA_ENABLE_NEWSAPI=true
# Provider resilience and quota guardrails (server-only)
MARKET_DATA_PROVIDER_MAX_QUEUE=100
MARKET_DATA_PROVIDER_QUEUE_TIMEOUT_MS=1500
MARKET_DATA_RETRY_ATTEMPTS=2
MARKET_DATA_RETRY_BASE_DELAY_MS=150
MARKET_DATA_RETRY_MAX_DELAY_MS=2000
MARKET_DATA_CIRCUIT_FAILURE_THRESHOLD=5
MARKET_DATA_CIRCUIT_OPEN_MS=30000
# Optional provider overrides, for example:
# MARKET_DATA_RATE_LIMIT_FINNHUB_PER_MINUTE=60
# MARKET_DATA_BURST_FINNHUB=8
# MARKET_DATA_CONCURRENCY_FINNHUB=4
