<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd-Agent fuer den automatischen Push.

  Laeuft alle drei Minuten, solange der Nutzer angemeldet ist. Drei Minuten
  sind ein Kompromiss: haeufig genug, dass ein fertiger Stand zeitnah oben
  liegt, selten genug, dass der Rechner nichts davon merkt. Das Skript selbst
  bricht in den allermeisten Laeufen sofort ab, weil nichts ansteht.

  Vor der Aktivierung: __PROJEKT__ durch den absoluten Projektpfad ersetzen. Die Anleitung in
  README-auto-push.md macht das mit sed.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.stockpilot.autopush</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__PROJEKT__/scripts/dev/auto-push.sh</string>
    <string>__PROJEKT__</string>
  </array>

  <key>StartInterval</key>
  <integer>180</integer>

  <key>RunAtLoad</key>
  <true/>

  <!-- Ausgabe des Agenten selbst. Das fachliche Protokoll schreibt das Skript
       nach scripts/dev/auto-push.log. -->
  <key>StandardOutPath</key>
  <string>__PROJEKT__/scripts/dev/auto-push.agent.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJEKT__/scripts/dev/auto-push.agent.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
